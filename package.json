{
  "name": "ecommerce-playwright-demo",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-grade React + TypeScript E-Commerce Application with Vitest Unit Tests & AI-selected Playwright E2E Regression Suite",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smart": "playwright-smart-test run",
    "test:smart:analyze": "playwright-smart-test analyze",
    "test:smart:comment": "playwright-smart-test comment",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright-smart-test": "^1.0.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "rollup": "4.67.2"
  }
}
