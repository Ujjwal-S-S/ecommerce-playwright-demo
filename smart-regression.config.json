{
  "testDir": "playwright/e2e/tests",
  "testMatch": ["**/*.spec.ts"],
  "pageObjectsDir": "playwright/e2e/pages",
  "components": [
    {
      "name": "checkout",
      "patterns": ["src/**/Checkout*", "playwright/e2e/**/checkout*"]
    },
    {
      "name": "payment",
      "patterns": ["src/**/Payment*", "playwright/e2e/**/payment*"]
    },
    {
      "name": "basket",
      "patterns": ["src/**/Cart*", "playwright/e2e/**/cart*", "src/**/basket*"]
    },
    {
      "name": "profile",
      "patterns": ["src/**/Profile*", "playwright/e2e/**/profile*"]
    }
  ],
  "safetyRules": {
    "fullRunPatterns": [
      "playwright.config.*",
      "package.json",
      "vite.config.*"
    ],
    "maxImpactRatioForFullRun": 0.8
  },
  "ai": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "temperature": 0.2
  }
}
