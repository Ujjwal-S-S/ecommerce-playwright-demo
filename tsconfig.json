{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["node", "@testing-library/jest-dom/vitest", "vite/client"]
  },
  "include": [
    "src",
    "playwright/**/*",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
